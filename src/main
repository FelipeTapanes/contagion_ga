import matplotlib.pyplot as plt
import matplotlib.ticker as ticker
import numpy as np
from nsga2_sir import run_nsga2, decode

def main():

    nodes, front = run_nsga2()

    print("Pareto front size:", len(front))

    # Extract objective values
    peaks = [ind.fitness.values[0] for ind in front]
    costs = [ind.fitness.values[1] for ind in front]

    print_strong_interventions(front[0], nodes, threshold=0.7)

    # Plot Pareto front
    plt.scatter(costs, peaks)
    plt.xlabel("Intervention Cost")
    plt.ylabel("Peak Infected")
    plt.title("NSGA-II Pareto Front")
    ax = plt.gca()
    ax.yaxis.set_major_formatter(ticker.FuncFormatter(lambda x, pos: f"{x/1_000_000:.1f}M"))
    plt.show()


def print_strong_interventions(ind, nodes, threshold=0.7):
    z_beta, z_gamma, z_tau = decode(ind, len(nodes))

    print(f"\nPeak: {ind.fitness.values[0]:.0f}")
    print(f"Cost: {ind.fitness.values[1]:.2f}")

    print(f"\nCounties with beta > {threshold}:")
    for i, val in enumerate(z_beta):
        if val > threshold:
            print("  ", nodes[i], round(val, 3))

    print(f"\nCounties with gamma > {threshold}:")
    for i, val in enumerate(z_gamma):
        if val > threshold:
            print("  ", nodes[i], round(val, 3))

    print(f"\nCounties with tau > {threshold}:")
    for i, val in enumerate(z_tau):
        if val > threshold:
            print("  ", nodes[i], round(val, 3))

if __name__ == "__main__":
    main()